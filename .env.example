# ------------------------------------------------------------------
# نمونه متغیرهای محیطی پروژه شرکت خدماتی و بازاریابی مسلم ابراهیمی
# این فایل را کپی کرده و نام آن را .env بگذارید.
# هیچ کلید یا رمز واقعی در این فایل قرار ندهید.
# ------------------------------------------------------------------

# نام برنامه و محیط اجرا
APP_NAME="خدمات بازاریابی مسلم ابراهیمی"
APP_ENV=production
APP_DEBUG=false

# آدرس پایه سایت (بدون اسلش انتهایی)
# اگر پروژه در http://localhost/MuslimEbrahimiServicesMarketingCompany اجرا می‌شود:
APP_URL="http://localhost/MuslimEbrahimiServicesMarketingCompany"

# منطقه زمانی و زبان پیش‌فرض
APP_TIMEZONE="Asia/Kabul"
APP_LOCALE="fa"

# ------------------------------------------------------------------
# اتصال پایگاه داده (MariaDB/MySQL)
# ------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=muslim_ebrahimi_marketing
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------
# تنظیمات امنیتی و نشست
# ------------------------------------------------------------------
# یک رشته تصادفی و بلند برای امضای توکن‌ها و نشست‌ها بسازید
APP_KEY=

# طول عمر نشست به ثانیه (پیش‌فرض ۲ ساعت)
SESSION_LIFETIME=7200

# ------------------------------------------------------------------
# محدودیت بارگذاری تصویر
# ------------------------------------------------------------------
# حداکثر حجم مجاز به مگابایت
UPLOAD_MAX_MB=3
# پسوندهای مجاز (با کاما جدا شود)
UPLOAD_ALLOWED_EXT=jpg,jpeg,png,webp,gif,svg
